TELEGRAM_API_ID=
TELEGRAM_API_HASH=
USER_SESSION_STRING=
CONTROL_BOT_TOKEN=
ADMIN_USER_ID=
DATABASE_URL=postgresql://user:password@host:5432/database
SCAN_INTERVAL_MINUTES=360
HISTORY_LIMIT=50
LOG_LEVEL=INFO

# Costela Atendimento PV (desligada por padrão)
# Link privado: preencher somente na Railway; não publicar no GitHub.
PV_PREVIEW_LINK=
PV_REPLY_AUTO_ENABLE=false
PV_REPLY_DELAY_SECONDS=60
PV_FOLLOWUP_MIN_HOURS=23
PV_FOLLOWUP_MAX_HOURS=25
PV_FOLLOWUP_MAX_CYCLES=7
PV_WEEKLY_INTERVAL_HOURS=168
# Ramo opcional após o link de prévias. As três fotos são cadastradas no
# privado do painel; nunca coloque mídia sensível no repositório.
PV_TWO_SCREENS_ENABLED=false

# Atendimento de Grupos (desligado por padrão)
GROUP_REPLY_ALLOWLIST=
GROUP_REPLY_MIN_DELAY_SECONDS=70
GROUP_REPLY_MAX_DELAY_SECONDS=90
GROUP_REPLY_MIN_COOLDOWN_SECONDS=95
GROUP_REPLY_MAX_COOLDOWN_SECONDS=110
GROUP_REPLY_RESPONSES=

# Costela Testar BOTSON (desligada por padrão)
BOTSON_PREVIEW_ALLOWLIST=
BOTSON_BOT_TARGETS=
BOTSON_CONTROLLER_ID=
# Alternativa ao ID: permite parear uma vez por texto no privado da conta.
BOTSON_PAIR_CODE=
BOTSON_TRIGGER_TEXT=testar
BOTSON_MAX_CLICKS=12
BOTSON_MAX_DEPTH=5
BOTSON_ENTRY_WAIT_SECONDS=12
BOTSON_RECOVERY_WAIT_SECONDS=20
BOTSON_REPORT_TTL_SECONDS=21600
